<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
      $(Description)

      Ninject integration: configures AutoFactories to generate factories that resolve
      [FromFactory] parameters from a Ninject IKernel, and adds extension methods to bind the
      generated factories and their interfaces within your Ninject modules.
    </Description>
    <PackageIcon>Icon.jpg</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\img\Icon.jpg">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ninject" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AutoFactories\AutoFactories.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="GitVersion.MsBuild">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>